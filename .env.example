# Mission Control — environment configuration
# Copy this file to .env and fill in the values for your setup.
# The server reads these at startup via process.env.

# ── Server ────────────────────────────────────────────────────────────────────

# Port to listen on (default: 4317)
PORT=4317

# Server-side result cache TTL in milliseconds (default: 30000)
CACHE_TTL_MS=30000

# ── Authentication ─────────────────────────────────────────────────────────────

# If set, all /api/* requests must include this token as:
#   Authorization: Bearer <token>   or   X-Dashboard-Token: <token>
# Leave unset to run open on your LAN (recommended behind a firewall).
# DASHBOARD_TOKEN=your-secret-token-here

# ── GitHub ─────────────────────────────────────────────────────────────────────

# GitHub personal access token — optional if `gh` CLI is already authenticated.
# Required if running in a non-interactive environment.
# GITHUB_TOKEN=ghp_xxxx

# Comma-separated list of owner/repo pairs to track for PRs, workflows, and cost.
# Example: REPOS=myorg/api,myorg/frontend,myorg/mobile
REPOS=owner/repo1,owner/repo2

# ── Research reports ───────────────────────────────────────────────────────────

# Directory where your agent drops daily research reports (*.md files).
# Reports are expected to contain a *Theme:* line and bullet findings.
# Default: ~/clawbot/reports
# MC_REPORTS_DIR=~/clawbot/reports

# ── Claude token usage ─────────────────────────────────────────────────────────

# Path to the Claude Code project directory containing *.jsonl conversation files.
# Find it at: ~/.claude/projects/<slug-of-your-project-path>/
# Example: MC_CLAUDE_PROJECT_DIR=~/.claude/projects/-home-yourname-myproject
MC_CLAUDE_PROJECT_DIR=~/.claude/projects/-home-yourname-workspace

# ── Worker / subagent logs ─────────────────────────────────────────────────────

# Comma-separated glob patterns for worker log files to surface in the Subagents panel.
# Supports simple * wildcards.
# Default: /tmp/*-worker.log,/tmp/tf-watch.log
# MC_WORKER_LOG_GLOB=/tmp/*-worker.log,/tmp/tf-watch.log
